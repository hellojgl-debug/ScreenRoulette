package com.hellojgl.screenroulette.ui.theme

import android.app.Activity
import android.os.Build
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.ui.graphics.Color
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.dynamicDarkColorScheme
import androidx.compose.material3.dynamicLightColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.ui.platform.LocalContext

// ScreenRoulette casino palette
private val DarkColorScheme = darkColorScheme(
    primary = Color(0xFFD6B66A),
    onPrimary = Color(0xFF172719),
    primaryContainer = Color(0xFF59451D),
    onPrimaryContainer = Color(0xFFFFE7AC),
    secondary = Color(0xFF49B889),
    onSecondary = Color(0xFF062B1C),
    tertiary = Color(0xFFF28B88),
    onTertiary = Color(0xFF4B1117),
    background = Color(0xFF10291F),
    onBackground = Color(0xFFF2EEE2),
    surface = Color(0xFF18392B),
    onSurface = Color(0xFFF2EEE2),
    surfaceVariant = Color(0xFF294737),
    onSurfaceVariant = Color(0xFFD2DCCF),
    outline = Color(0xFF91A895),
    error = Color(0xFFFF8A80),
    onError = Color(0xFF4B1117)
)

private val LightColorScheme = lightColorScheme(
    primary = Color(0xFF146B48),
    onPrimary = Color.White,
    primaryContainer = Color(0xFFE7D39D),
    onPrimaryContainer = Color(0xFF332608),
    secondary = Color(0xFF775714),
    onSecondary = Color.White,
    tertiary = Color(0xFFB3262E),
    onTertiary = Color.White,
    background = Color(0xFFF6F3E9),
    onBackground = Color(0xFF19291F),
    surface = Color(0xFFFFFCF3),
    onSurface = Color(0xFF19291F),
    surfaceVariant = Color(0xFFE6EBDD),
    onSurfaceVariant = Color(0xFF3C5041),
    outline = Color(0xFF697E6C),
    error = Color(0xFFB3262E),
    onError = Color.White
)

@Composable
fun ScreenRouletteTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    // Dynamic color is available on Android 12+
    dynamicColor: Boolean = true,
    content: @Composable () -> Unit
) {
    val colorScheme = when {
        dynamicColor && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S -> {
            val context = LocalContext.current
            if (darkTheme) dynamicDarkColorScheme(context) else dynamicLightColorScheme(context)
        }

        darkTheme -> DarkColorScheme
        else -> LightColorScheme
    }

    MaterialTheme(
        colorScheme = colorScheme,
        typography = Typography,
        content = content
    )
}